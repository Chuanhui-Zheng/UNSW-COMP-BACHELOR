#include<stdio.h>
int main(void){
    int a;
    printf("What number would you like to see: ");
    scanf("%d", &a);
    
    while (a != 1){int m = 1;
        while (m <= a){
            printf("*");
            m += 1;
        }
        printf("\n");
        if (a%2 == 0){
            a = a/2;
        }
        else{
            a = 3*a+1;
        }
    }
}
