#include<stdio.h>
int main(void){
    int a;
    printf("Enter number: ");
    scanf("%d", &a);
    printf("The factors of %d are:", a);
    int p = 1;
    int sum = 0;
    while (p <= a){
        if (a%p == 0){
            printf("%d\n", p);
            sum += p;
        }
        p += 1;
    }
    printf("Sum of factors = %d\n", sum);
    if (sum == 2*a){
        printf("%d is a perfect number\n", a);
    }
    else{
        printf("%d is not a perfect number\n", a);
    }
}
